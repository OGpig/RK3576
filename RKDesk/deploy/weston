#!/usr/bin/env python3
"""Weston launcher for the TL3576 Buildroot image.

The original /usr/bin/weston ELF was destroyed on this board.  libexec_weston
still exports wet_main(), so this wrapper provides the same command-line
behaviour without a compiler.

Install to /usr/bin/weston (see deploy.sh).
"""
import ctypes
import os
import sys


def connected(head):
    try:
        with open('/sys/class/drm/card0-%s/status' % head) as handle:
            return handle.read().strip() == 'connected'
    except OSError:
        return False


primary = os.environ.get('WESTON_DRM_PRIMARY', 'HDMI-A-1')
if not connected(primary) and connected('DSI-1'):
    os.environ['WESTON_DRM_PRIMARY'] = 'DSI-1'
os.environ.setdefault('XDG_RUNTIME_DIR', '/var/run')

lib = ctypes.CDLL('/usr/lib/weston/libexec_weston.so.0')
lib.wet_main.argtypes = [ctypes.c_int, ctypes.POINTER(ctypes.c_char_p), ctypes.c_void_p]
lib.wet_main.restype = ctypes.c_int
argv = [b'weston'] + [arg.encode() for arg in sys.argv[1:]]
array = (ctypes.c_char_p * len(argv))(*argv)
sys.exit(lib.wet_main(len(argv), array, None))
